# Copiar a .env y completar. Nunca commitear .env.

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos (compose.yaml levanta este Postgres en desarrollo)
DATABASE_URL=postgresql://naturalland:naturalland@localhost:5432/naturalland

# Auth.js — generar AUTH_SECRET con: npx auth secret
AUTH_SECRET=
# Dirección canónica del login con Google; su /api/auth/callback/google debe estar autorizada
# en Google Cloud. Desarrollo: http://localhost:3000 · Producción: la URL pública del sitio.
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Correos con acceso al panel (separados por coma). Se cargan a AdminUser con: npm run db:seed
ADMIN_EMAILS=

# Traducción automática
TRANSLATION_PROVIDER=deepl
DEEPL_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Analytics 4: ID de medición (G-XXXXXXXXXX). Vacío = sin analítica.
NEXT_PUBLIC_GA_ID=

# Google Search Console: código del meta de verificación (solo el content="..."). Vacío = no se agrega.
GOOGLE_SITE_VERIFICATION=

# Correo saliente (SMTP del buzón info@naturallandcr.com): confirmación al cliente y aviso de cada solicitud.
# Ejemplos de host: smtp.gmail.com (Google Workspace, con contraseña de aplicación), smtp.zoho.com,
# smtp.hostinger.com, mail.tudominio.com (cPanel). Puerto 465 (SSL) o 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@naturallandcr.com
SMTP_PASSWORD=
MAIL_FROM="Natural Land CR <info@naturallandcr.com>"
MAIL_NOTIFY_TO=info@naturallandcr.com

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin): claves de tipo "v3 (basado en puntuación)".
# Vacío = el formulario funciona sin reCAPTCHA (solo con el límite de envíos y el campo trampa).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
