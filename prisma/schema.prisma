// La URL de conexión se configura en prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TourStatus {
  DRAFT
  PUBLISHED
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
}

/// Sección del sitio y del panel en la que aparece el tour.
/// TOUR: tours generales. DAY_TOUR: tours de un día. GIRA: giras de varios días.
enum TourCategory {
  TOUR
  DAY_TOUR
  GIRA
}

enum Locale {
  es
  en
}

/// ORIGINAL: escrito en el admin (español). MACHINE: traducido por la API.
/// MANUAL: traducción corregida a mano; la retraducción automática no la sobrescribe.
enum TranslationSource {
  ORIGINAL
  MACHINE
  MANUAL
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Páginas públicas con encabezado (hero) configurable desde el panel.
enum HeroPage {
  HOME
  TOURS
  CONTACT
  /// Otros servicios
  SERVICES
  /// Planifica tu viaje (formulario de solicitudes)
  PLAN_TRIP
  /// Política de privacidad
  PRIVACY
  /// Página 404 ("Este sendero no existe")
  NOT_FOUND
  /// Acerca de mí
  ABOUT
}

/// Datos que no dependen del idioma.
model Tour {
  id              String       @id @default(cuid())
  status          TourStatus   @default(DRAFT)
  category        TourCategory @default(TOUR)
  featured        Boolean      @default(false)
  position        Int          @default(0)
  durationMinutes Int?
  difficulty      Difficulty?
  /// Nombre propio del lugar (p. ej. "La Fortuna, Alajuela"); no se traduce.
  location        String?
  /// Precio "a partir de" en USD que se muestra en la card; null = no se muestra.
  priceFrom       Int?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  translations TourTranslation[]
  media        Media[]

  @@index([status, featured, position])
  @@index([category, status, position])
}

model TourTranslation {
  id             String            @id @default(cuid())
  tourId         String
  locale         Locale
  /// Slug por idioma para SEO: /es/tours/volcan-arenal y /en/tours/arenal-volcano.
  slug           String
  title          String
  summary        String
  description    String            @db.Text
  itinerary      String?           @db.Text
  includes       String[]
  excludes       String[]
  whatToBring    String[]
  /// Tarifas de la sección "Precios", una por línea (p. ej. "Adultos: USD 500"). Se traducen.
  prices         String[]          @default([])
  meetingPoint   String?
  seoTitle       String?
  seoDescription String?
  source         TranslationSource
  /// Hash del contenido en español del que salió esta traducción; si cambia, hay que retraducir.
  sourceHash     String?
  translatedAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, locale])
  @@unique([locale, slug])
}

/// Solo metadatos: el archivo vive en Cloudinary.
model Media {
  id          String    @id @default(cuid())
  tourId      String
  type        MediaType
  /// public_id de Cloudinary, necesario para transformar y borrar el recurso.
  publicId    String    @unique
  url         String
  format      String
  width       Int
  height      Int
  bytes       Int
  durationSec Float?
  altEs       String?
  altEn       String?
  /// Orden en la galería; la posición 0 es la portada del tour.
  position    Int
  createdAt   DateTime  @default(now())

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, position])
}

/// Fondo del hero de una página pública: una imagen o un video por página, aparte de los medios
/// de los tours. Solo metadatos; el archivo vive en Cloudinary.
model HeroMedia {
  page        HeroPage  @id
  type        MediaType
  publicId    String    @unique
  url         String
  format      String
  width       Int
  height      Int
  bytes       Int
  durationSec Float?
  updatedAt   DateTime  @updatedAt
}

/// Lista blanca del panel admin: solo estos correos pueden iniciar sesión con Google.
model AdminUser {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Estado de una solicitud del formulario "Planifica tu viaje" en el panel.
enum RequestStatus {
  NEW
  CONTACTED
  CLOSED
}

/// Solicitud enviada desde el formulario público. Se ve en el panel (Solicitudes).
model ContactRequest {
  id                 String        @id @default(cuid())
  status             RequestStatus @default(NEW)
  firstName          String
  lastName           String
  email              String
  /// País del prefijo telefónico (ISO 3166-1 alfa-2, p. ej. "CR").
  phoneCountry       String
  /// Número completo en formato internacional E.164 (p. ej. "+50688887777").
  phone              String
  /// Nacionalidad (ISO 3166-1 alfa-2).
  nationality        String
  message            String        @db.Text
  /// Idioma en que se llenó el formulario: el correo de confirmación va en ese idioma.
  locale             Locale
  /// Puntaje de reCAPTCHA v3 (0 = bot, 1 = humano); null si reCAPTCHA no estaba configurado.
  recaptchaScore     Float?
  /// Cuándo se envió el correo de confirmación al cliente y el aviso a info@ (null = no se envió).
  confirmationSentAt DateTime?
  notificationSentAt DateTime?
  /// HMAC-SHA256 de la IP (con AUTH_SECRET): limita envíos por IP sin guardar la IP en claro.
  ipHash             String?
  /// Cuándo aceptó la Política de privacidad (null = solicitudes anteriores a la casilla).
  consentAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
}

/// Red social de una cifra de "Acerca de mí": enlaza al perfil de siteConfig.social.
enum SocialNetwork {
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

/// Biografía de "Acerca de mí": una sola fila (id "about").
/// El inglés se traduce con la API al guardar; si se corrige a mano (enManual), no se vuelve a sobrescribir.
model AboutProfile {
  id            String   @id @default("about")
  bioEs         String   @default("") @db.Text
  bioEn         String?  @db.Text
  /// Frase destacada junto a la biografía.
  quoteEs       String?
  quoteEn       String?
  enManual      Boolean  @default(false)
  /// Foto de Anthony (Cloudinary).
  photoPublicId String?  @unique
  photoUrl      String?
  photoWidth    Int?
  photoHeight   Int?
  updatedAt     DateTime @updatedAt
}

/// Cifra de "Acerca de mí" (seguidores en una red o un dato propio: años de experiencia, especies...).
/// Se escribe a mano en el panel.
model SocialStat {
  id        String         @id @default(cuid())
  /// null = cifra propia, sin red.
  network   SocialNetwork?
  value     Int
  /// Se muestra pegado al número: "+", "%".
  suffix    String?
  labelEs   String
  labelEn   String?
  enManual  Boolean        @default(false)
  /// También aparece en la franja del inicio.
  featured  Boolean        @default(false)
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([position])
}

/// Aliado (marca, hotel, organización) de "Acerca de mí". El logo vive en Cloudinary.
model Partner {
  id           String   @id @default(cuid())
  /// Nombre propio: no se traduce.
  name         String
  url          String?
  logoPublicId String   @unique
  logoUrl      String
  logoWidth    Int
  logoHeight   Int
  descEs       String?
  descEn       String?
  enManual     Boolean  @default(false)
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, position])
}
